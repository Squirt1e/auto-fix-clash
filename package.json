{
  "name": "auto-fix-clash",
  "version": "1.0.0",
  "description": "为 Clash/mihomo 代理组自动挑选真正可用的节点（判据是目标站点的真实响应，而不是延迟或节点名）",
  "keywords": [
    "clash",
    "mihomo",
    "clash-verge",
    "clash-party",
    "proxy",
    "proxy-group",
    "chatgpt",
    "codex"
  ],
  "license": "MIT",
  "author": "Squirt1e",
  "homepage": "https://github.com/Squirt1e/auto-fix-clash#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Squirt1e/auto-fix-clash.git"
  },
  "bugs": {
    "url": "https://github.com/Squirt1e/auto-fix-clash/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "afc": "./bin/afc.js"
  },
  "files": [
    "bin",
    "dist",
    "afc.config.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "afc": "node src/cli/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
