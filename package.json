    "health-check",
    "self-healing",
    "latency-test",
    "chatgpt",
    "codex",
    "openai",
    "launchd",
    "systemd",
    "schtasks",
    "task-scheduler",
    "cross-platform",
    "windows",
    "macos",
    "linux",
    "cli",
    "nodejs",
    "代理",
    "节点切换",
    "自动切换",
    "机场订阅"
  ],
  "license": "MIT",
  "author": "Squirt1e",
  "homepage": "https://github.com/Squirt1e/auto-fix-clash#readme",
  "repository": {
    "type": "git",
